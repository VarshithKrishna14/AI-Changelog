# ── Corsair ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
CORSAIR_KEK=your-generated-base64-key

# ── Nebius AI Studio ──────────────────────────────────────────────────────────
# Get your key at https://studio.nebius.ai → API Keys
# Model used: meta-llama/Llama-3.3-70B-Instruct (OpenAI-compatible endpoint)
NEBIUS_API_KEY=your-nebius-api-key-here

# ── Slack ─────────────────────────────────────────────────────────────────────
# The channel ID or name to post release announcements to (e.g. C0123456789 or #releases)
SLACK_CHANNEL=#releases
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret-optional

# ── Notion ────────────────────────────────────────────────────────────────────
# The ID of the parent Notion page where release pages will be created.
# Found in the page URL: notion.so/<workspace>/<PAGE_ID>
NOTION_PARENT_PAGE_ID=your-notion-page-id-here
NOTION_API_KEY=secret_your_notion_integration_token

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_github_token
GITHUB_WEBHOOK_SECRET=optional-secret-if-you-enable-it

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
