# ── Corsair ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
CORSAIR_KEK=your-generated-base64-key

# Path to the SQLite database file (default: ./corsair.db next to package.json).
# The corsair_permissions table is auto-created on first start.
# CORSAIR_DB_PATH=./corsair.db

# ── OpenAI ────────────────────────────────────────────────────────────────────
# Get your key at https://platform.openai.com/api-keys
# Model used: gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-api-key-here

# ── Slack ─────────────────────────────────────────────────────────────────────
# The channel ID or name to post release announcements to (e.g. C0123456789 or #releases)
SLACK_CHANNEL=#releases
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret-optional

# ── Notion ────────────────────────────────────────────────────────────────────
# The ID of the parent Notion page where release pages will be created.
# Found in the page URL: notion.so/<workspace>/<PAGE_ID>
NOTION_PARENT_PAGE_ID=your-notion-page-id-here
NOTION_API_KEY=secret_your_notion_integration_token

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=ghp_your_github_token
GITHUB_WEBHOOK_SECRET=optional-secret-if-you-enable-it

# ── Corsair Permission Gate ───────────────────────────────────────────────────
# Controls Corsair's built-in permission mode for Slack and Notion plugins.
#
# false (default) → mode: 'open'   — writes (messages.post, pages.createPage) execute immediately.
# true            → mode: 'strict' — writes are intercepted; Corsair stores the full API call
#                                    in corsair_permissions (SQLite) and throws with a token.
#                                    Approve: GET /approve/:token   Deny: GET /deny/:token
#                                    List all pending: GET /pending
#
# GitHub is always 'readonly' regardless of this flag.
REQUIRE_APPROVAL=false

# Your Slack user ID (e.g. U04XXXXXXX) — when REQUIRE_APPROVAL=true, the server will DM
# you via a direct Slack API call (bypasses the Corsair permission check for notifications).
# Find it: Slack → click your name → "Copy member ID".
SLACK_APPROVER_ID=U04XXXXXXX

# The public base URL of this server (used to build approve/deny links in DMs).
# For local dev with ngrok: https://abc123.ngrok.io
# Leave blank to use http://localhost:PORT
PUBLIC_URL=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
